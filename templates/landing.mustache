<div class="pp-container">
  <div class="pp-header">
    <h2>{{#str}} welcome_title, local_dashboard {{/str}}, {{userfullname}} 👋</h2>
    <p>{{#str}} welcome_sub, local_dashboard {{/str}}</p>
  </div>

  <div class="pp-grid">
    {{#hasnotices}}
    <!-- Avisos dinâmicos -->
    <div class="pp-notices pp-notices-{{notices.0.type}}" id="pp-notices-bar" role="alert">
      <span class="pp-notices-icon" id="pp-notices-icon">{{notices.0.icon}}</span>
      <div class="pp-notices-body">
        <div class="pp-notices-title" id="pp-notices-title">{{notices.0.title}}</div>
        {{#notices.0.body}}<p class="pp-notices-text" id="pp-notices-text">{{{notices.0.body}}}</p>{{/notices.0.body}}
      </div>
      <div class="pp-notices-nav">
        <span class="pp-notices-counter" id="pp-notices-counter"></span>
        <button class="pp-notices-btn" id="pp-notices-prev" onclick="ppNoticeNav(-1)" type="button" aria-label="Aviso anterior">&#8592;</button>
        <button class="pp-notices-btn" id="pp-notices-playpause" onclick="ppNoticeToggleAuto()" type="button" aria-label="Pausar rotação">⏸</button>
        <button class="pp-notices-btn" id="pp-notices-next" onclick="ppNoticeNav(1)"  type="button" aria-label="Próximo aviso">&#8594;</button>
      </div>
    </div>
    {{/hasnotices}}

    {{#hasbanners}}
    <!-- Banners / Carrossel -->
    <section class="pp-card pp-card-banners">
      <div class="pp-banners-carousel" id="pp-banners-carousel">
        <div class="pp-banners-track" id="pp-banners-track">
          {{#banners}}
          <div class="pp-banner-slide">
            {{#has_link}}
            <a href="{{link_url}}" target="_blank" rel="noopener" class="pp-banner-link">
              <img src="{{imageurl}}" alt="{{alt_text}}" class="pp-banner-img" loading="lazy">
            </a>
            {{/has_link}}
            {{^has_link}}
            <img src="{{imageurl}}" alt="{{alt_text}}" class="pp-banner-img" loading="lazy">
            {{/has_link}}
          </div>
          {{/banners}}
        </div>

        {{#bannersmorethanone}}
        <!-- Setas de navegação -->
        <button class="pp-carousel-btn pp-carousel-prev" id="pp-carousel-prev" type="button" aria-label="Anterior">&#10094;</button>
        <button class="pp-carousel-btn pp-carousel-next" id="pp-carousel-next" type="button" aria-label="Próximo">&#10095;</button>

        <!-- Indicadores (dots) -->
        <div class="pp-carousel-dots" id="pp-carousel-dots">
        </div>
        {{/bannersmorethanone}}
      </div>
    </section>
    {{/hasbanners}}

    <!-- Mensagens -->
    <section class="pp-card pp-card-messages">
      <div class="pp-messages-header">
        <h3>💬 {{#str}} messages, local_dashboard {{/str}}</h3>
        <div class="pp-messages-summary">
          <span class="pp-total-conversations">{{totalunreadconversations}} conversas não lidas</span>
        </div>
      </div>

      <div class="pp-messages-grid">
      {{#messages}}
        <a class="pp-message-item" href="{{url}}">
          <div class="pp-message-header">
            <span class="pp-message-name">{{name}}</span>
            <span class="pp-message-unread">{{unreadcount}}</span>
          </div>
          <div class="pp-message-preview"><span class="pp-message-sender">{{sendername}}</span>{{lastmessage}}</div>
          <div class="pp-message-time">{{timeago}}</div>
        </a>
      {{/messages}}
      {{#messagesempty}}<p class="pp-empty">Nenhuma mensagem não lida.</p>{{/messagesempty}}
      </div>

      <div class="pp-card-footer">
        <a href="{{allmessagesurl}}" class="pp-btn-secondary">Ver todas as mensagens</a>
      </div>
    </section>

    <!-- Minhas disciplinas -->
    <section class="pp-card">
      <div class="pp-courses-header">
        <h3>📚 {{#str}} mycourses, local_dashboard {{/str}}</h3>
        {{#haspoloview}}
        <div class="pp-view-toggle" role="group">
          <button class="pp-toggle-view active" id="pp-btn-category"
                  onclick="ppSwitchView('category')" type="button">
            {{#str}} view_by_category, local_dashboard {{/str}}
          </button>
          <button class="pp-toggle-view" id="pp-btn-polo"
                  onclick="ppSwitchView('polo')" type="button">
            🗺️ {{#str}} view_by_polo, local_dashboard {{/str}}
          </button>
        </div>
        {{/haspoloview}}
      </div>

      <!-- Filtro por papel -->
      {{#hasrolefilter}}
      <div class="pp-role-filters">
        <button class="pp-role-btn active" data-role="all" onclick="ppFilterRole(this)" type="button">
          {{#str}} role_filter_all, local_dashboard {{/str}}
        </button>
        {{#rolefilters}}
          <button class="pp-role-btn" data-role="{{roleshort}}" onclick="ppFilterRole(this)" type="button">{{rolename}}</button>
        {{/rolefilters}}
      </div>
      {{/hasrolefilter}}

      <!-- Visão por Categoria (padrão) -->
      <div class="pp-courses-list">
      <div id="pp-view-category">
        {{#courses}}
          <div class="pp-category-group">
            <h4 class="pp-category-title">{{categoryname}} ({{coursecount}})</h4>
            {{#courses}}
              <a class="pp-item" href="{{url}}" data-roles="{{rolescsv}}">
                <span class="pp-item-title">{{fullname}}</span>
                {{#hasbadge}}<span class="pp-role-badges">{{#roles}}<span class="pp-role-badge">{{rolename}}</span>{{/roles}}</span>{{/hasbadge}}
              </a>
            {{/courses}}
          </div>
        {{/courses}}
        {{#coursesempty}}<p class="pp-empty">{{#str}} nocourses, local_dashboard {{/str}}</p>{{/coursesempty}}
      </div>

      <!-- Visão por Polo -->
      {{#haspoloview}}
      <div id="pp-view-polo" style="display:none;">
        {{#coursesbypolo}}
          <div class="pp-category-group">
            <h4 class="pp-category-title pp-polo-title">📍 {{categoryname}} ({{coursecount}})</h4>
            {{#courses}}
              <a class="pp-item" href="{{url}}" data-roles="{{rolescsv}}">
                <span class="pp-item-title">{{fullname}}</span>
                {{#hasbadge}}<span class="pp-role-badges">{{#roles}}<span class="pp-role-badge">{{rolename}}</span>{{/roles}}</span>{{/hasbadge}}
              </a>
            {{/courses}}
          </div>
        {{/coursesbypolo}}
      </div>
      {{/haspoloview}}
      </div>{{! end pp-courses-list }}
    </section>

    <!-- Calendário Acadêmico -->
    <section class="pp-card pp-card-calendario">
      <h3>📅 {{#str}} calendario, local_dashboard {{/str}}</h3>
      
      {{#hascalendario}}
        <!-- Filtros -->
        <div class="cw-filters">
          <div class="cw-filter-group">
            <label for="cw-semestre-filter">Semestre:</label>
              <select id="cw-semestre-filter" class="cw-select" onchange="cwUpdateFilters()">
              <option value="0">Todos</option>
              {{#calendario.semestre_options}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{nome}}</option>
              {{/calendario.semestre_options}}
            </select>
          </div>
          <div class="cw-filter-check">
              <input type="checkbox" id="cw-filter-regular" checked onchange="cwUpdateFilters()">
              <label for="cw-filter-regular">Regulares</label>
            </div>
            <div class="cw-filter-check">
              <input type="checkbox" id="cw-filter-reoferta" checked onchange="cwUpdateFilters()">
            <label for="cw-filter-reoferta">Reofertas</label>
          </div>
        </div>
        
        <!-- Widget do Calendário -->
        {{#calendario.semestres}}
          <div class="cw-semestre" data-semestre-id="{{id}}">
            <div class="cw-semestre-header" style="background-color: {{cor_fundo}}; color: {{cor_texto}};">
              <h4 class="cw-semestre-titulo">{{nome}}</h4>
            </div>
            
            <div class="cw-timeline-container">
              <!-- Desktop: Timeline Table -->
              <table class="cw-timeline-table d-none d-md-table">
                <thead>
                  <tr>
                    <th class="cw-th-disciplina">Disciplina</th>
                    {{#meses}}
                      <th class="cw-th-mes" title="{{nome_completo}}">{{nome}}</th>
                    {{/meses}}
                    <th class="cw-th-horario">Aulas</th>
                  </tr>
                </thead>
                <tbody>
                  {{#disciplinas}}
                    <tr class="cw-disciplina-row"
                        data-reoferta="{{#is_reoferta}}1{{/is_reoferta}}{{^is_reoferta}}0{{/is_reoferta}}"
                        data-toggle="tooltip" 
                        data-html="true"
                        data-placement="top"
                        title="<strong>{{nome}}</strong>{{#codigo}}<br>Código: {{codigo}}{{/codigo}}{{#professor}}<br>Prof: {{professor}}{{/professor}}{{#datainicio_fmt}}<br>📅 {{datainicio_fmt}} → {{datafim_fmt}}{{/datainicio_fmt}}{{#cargahoraria}}<br>CH: {{cargahoraria}}h{{/cargahoraria}}{{#sala}}<br>Sala: {{sala}}{{/sala}}{{#is_reoferta}}<br><span class='badge badge-warning'>Reoferta</span>{{/is_reoferta}}">
                      <td class="cw-td-disciplina" style="background-color: {{cor}}; color: {{cor_texto}};">
                        <div class="cw-disc-nome">{{nome}}</div>
                        {{#codigo}}<div class="cw-disc-codigo">{{codigo}}</div>{{/codigo}}
                        {{#is_reoferta}}<span class="cw-badge-reoferta">R</span>{{/is_reoferta}}
                      </td>
                      {{#meses_timeline}}
                        <td class="cw-td-timeline">
                          {{#ativo}}
                            <div class="cw-timeline-bar" style="left: {{pos_inicio}}%; width: {{largura}}%; background-color: {{cor}};"></div>
                            {{#eh_inicio}}<span class="cw-dia-marker cw-dia-inicio" style="--pos:{{pos_inicio}}%;background-color:{{cor}};color:{{cor_texto}};">{{dia_inicio}}</span>{{/eh_inicio}}
                            {{#eh_fim}}<span class="cw-dia-marker cw-dia-fim" style="--pos:{{pos_fim}}%;background-color:{{cor}};color:{{cor_texto}};">{{dia_fim}}</span>{{/eh_fim}}
                          {{/ativo}}
                        </td>
                      {{/meses_timeline}}
                      <td class="cw-td-horario">
                        {{#horario}}<span class="cw-horario-text">{{horario}}</span>{{/horario}}
                        {{^horario}}<span class="cw-horario-empty">-</span>{{/horario}}
                      </td>
                    </tr>
                  {{/disciplinas}}
                </tbody>
              </table>
              
              <!-- Mobile: Card List -->
              <div class="cw-mobile-list d-md-none">
                {{#disciplinas}}
                  <div class="cw-mobile-card" data-reoferta="{{#is_reoferta}}1{{/is_reoferta}}{{^is_reoferta}}0{{/is_reoferta}}" style="border-left-color: {{cor}};">
                    <div class="cw-mobile-header">
                      <div class="cw-mobile-nome" style="color: {{cor}};">
                        {{nome}}
                        {{#is_reoferta}}<span class="cw-badge-reoferta">R</span>{{/is_reoferta}}
                      </div>
                      {{#codigo}}<div class="cw-mobile-codigo">{{codigo}}</div>{{/codigo}}
                    </div>
                    <div class="cw-mobile-details">
                      {{#professor}}<div class="cw-mobile-info"><i class="fa fa-user"></i> {{professor}}</div>{{/professor}}
                      {{#datainicio_fmt}}
                        <div class="cw-mobile-info"><i class="fa fa-calendar"></i> {{datainicio_fmt}} - {{datafim_fmt}}</div>
                      {{/datainicio_fmt}}
                      {{#horario}}<div class="cw-mobile-info"><i class="fa fa-clock-o"></i> {{horario}}</div>{{/horario}}
                      {{#sala}}<div class="cw-mobile-info"><i class="fa fa-map-marker"></i> {{sala}}</div>{{/sala}}
                    </div>
                    <!-- Mini timeline bar -->
                    <div class="cw-mobile-timeline">
                      <div class="cw-mobile-timeline-track">
                        {{#meses_timeline}}
                          <div class="cw-mobile-timeline-segment {{#ativo}}active{{/ativo}}" 
                               style="{{#ativo}}background-color: {{cor}};{{/ativo}}"></div>
                        {{/meses_timeline}}
                      </div>
                    </div>
                  </div>
                {{/disciplinas}}
              </div>
            </div>
          </div>
        {{/calendario.semestres}}
        
        <!-- Footer com links -->
        <div class="cw-footer">
          <a href="{{calendario.fullcalendarurl}}" class="pp-btn-secondary">Ver calendário completo</a>
          {{#calendario.canmanage}}
            <a href="{{calendario.manageurl}}" class="pp-btn-primary">Gerenciar</a>
          {{/calendario.canmanage}}
        </div>
      {{/hascalendario}}
      
      {{^hascalendario}}
        <div class="cw-empty">
          <i class="fa fa-calendar-o fa-3x"></i>
          <p>{{#str}} nocalendario, local_dashboard {{/str}}</p>
          <a href="{{calendario.fullcalendarurl}}" class="pp-btn-secondary" style="margin-top:8px;display:inline-block;">Ver calendário completo</a>
          {{#calendario.canmanage}}
            <a href="{{calendario.manageurl}}" class="btn btn-primary btn-sm">Configurar Calendário</a>
          {{/calendario.canmanage}}
        </div>
      {{/hascalendario}}
    </section>
  </div>
</div>

{{#js}}
require(['jquery'], function($) {
    $('[data-toggle="tooltip"]').tooltip({
        container: 'body',
        trigger: 'hover'
    });
});

window.ppSwitchView = function(view) {
    var catView  = document.getElementById('pp-view-category');
    var poloView = document.getElementById('pp-view-polo');
    var btnCat   = document.getElementById('pp-btn-category');
    var btnPolo  = document.getElementById('pp-btn-polo');
    if (!catView || !poloView) { return; }
    catView.style.display  = view === 'category' ? '' : 'none';
    poloView.style.display = view === 'polo'     ? '' : 'none';
    btnCat.classList.toggle('active',  view === 'category');
    btnPolo.classList.toggle('active', view === 'polo');
};

window.ppFilterRole = function(btn) {
    var role = btn.getAttribute('data-role');
    document.querySelectorAll('.pp-role-btn').forEach(function(b) {
        b.classList.toggle('active', b === btn);
    });
    document.querySelectorAll('.pp-item[data-roles]').forEach(function(item) {
        if (role === 'all') {
            item.style.display = '';
        } else {
            var roles = item.getAttribute('data-roles').split(',');
            item.style.display = roles.indexOf(role) !== -1 ? '' : 'none';
        }
    });
    // Ocultar grupos sem itens visíveis
    document.querySelectorAll('.pp-category-group').forEach(function(group) {
        var hasVisible = false;
        group.querySelectorAll('.pp-item').forEach(function(item) {
            if (item.style.display !== 'none') { hasVisible = true; }
        });
        group.style.display = hasVisible ? '' : 'none';
    });
};

window.cwUpdateFilters = function() {
    var selEl = document.getElementById('cw-semestre-filter');
    var semestreId = selEl ? selEl.value : '0';
    var regEl = document.getElementById('cw-filter-regular');
    var reoEl = document.getElementById('cw-filter-reoferta');
    var showRegular  = regEl  ? regEl.checked  : true;
    var showReoferta = reoEl  ? reoEl.checked  : true;

    document.querySelectorAll('.cw-semestre').forEach(function(sem) {
        var semId = sem.getAttribute('data-semestre-id') || '0';
        var semVisible = (semestreId === '0' || semId === semestreId);

        if (!semVisible) {
            sem.style.display = 'none';
            return;
        }

        // Filter desktop rows
        var visibleCount = 0;
        sem.querySelectorAll('tr.cw-disciplina-row').forEach(function(row) {
            var isReo = row.getAttribute('data-reoferta') === '1';
            var show  = isReo ? showReoferta : showRegular;
            row.style.display = show ? '' : 'none';
            if (show) { visibleCount++; }
        });

        // Filter mobile cards
        sem.querySelectorAll('.cw-mobile-card').forEach(function(card) {
            var isReo = card.getAttribute('data-reoferta') === '1';
            card.style.display = (isReo ? showReoferta : showRegular) ? '' : 'none';
        });

        // Hide the whole semestre block only when ALL rows are filtered out
        var totalRows = sem.querySelectorAll('tr.cw-disciplina-row').length;
        sem.style.display = (totalRows === 0 || visibleCount > 0) ? '' : 'none';
    });
};

// Avisos: navegação manual entre avisos
(function() {
    var notices = {{{noticesJson}}};
    var AUTO_INTERVAL = 6000; // ms entre avisos (altere aqui se quiser)
    var AUTO_ENABLED  = true; // começa com rotação ativa

    if (!notices || notices.length < 2) {
        var prev = document.getElementById('pp-notices-prev');
        var next = document.getElementById('pp-notices-next');
        var pp   = document.getElementById('pp-notices-playpause');
        if (prev) { prev.style.display = 'none'; }
        if (next) { next.style.display = 'none'; }
        if (pp)   { pp.style.display   = 'none'; }
        return;
    }

    var current   = 0;
    var timer     = null;
    var bar       = document.getElementById('pp-notices-bar');
    var titleEl   = document.getElementById('pp-notices-title');
    var textEl    = document.getElementById('pp-notices-text');
    var iconEl    = document.getElementById('pp-notices-icon');
    var counter   = document.getElementById('pp-notices-counter');
    var ppBtn     = document.getElementById('pp-notices-playpause');

    function render(idx) {
        var n = notices[idx];
        if (!n || !bar) { return; }
        bar.className = 'pp-notices pp-notices-' + n.type;
        if (titleEl) { titleEl.textContent = n.title; }
        if (textEl)  { textEl.innerHTML = n.body || ''; textEl.style.display = n.body ? '' : 'none'; }
        if (iconEl)  { iconEl.textContent = n.icon; }
        if (counter) { counter.textContent = (idx + 1) + ' / ' + notices.length; }
    }

    function startTimer() {
        stopTimer();
        if (!AUTO_ENABLED) { return; }
        timer = setInterval(function() {
            current = (current + 1) % notices.length;
            render(current);
        }, AUTO_INTERVAL);
    }

    function stopTimer() {
        if (timer) { clearInterval(timer); timer = null; }
    }

    window.ppNoticeNav = function(dir) {
        current = (current + dir + notices.length) % notices.length;
        render(current);
        // Reinicia o timer ao navegar manualmente
        if (AUTO_ENABLED) { startTimer(); }
    };

    window.ppNoticeToggleAuto = function() {
        AUTO_ENABLED = !AUTO_ENABLED;
        if (AUTO_ENABLED) {
            startTimer();
            if (ppBtn) { ppBtn.textContent = '⏸'; ppBtn.setAttribute('aria-label', 'Pausar rotação'); }
        } else {
            stopTimer();
            if (ppBtn) { ppBtn.textContent = '▶'; ppBtn.setAttribute('aria-label', 'Retomar rotação'); }
        }
    };

    // Pausa ao passar o mouse ou focar com teclado
    if (bar) {
        bar.addEventListener('mouseenter', stopTimer);
        bar.addEventListener('focusin',    stopTimer);
        bar.addEventListener('mouseleave', function() { if (AUTO_ENABLED) { startTimer(); } });
        bar.addEventListener('focusout',   function() { if (AUTO_ENABLED) { startTimer(); } });
    }

    render(0);
    if (counter) { counter.textContent = '1 / ' + notices.length; }
    startTimer();
})();

// ─── Banners / Carrossel ──────────────────────────────────────────────────────
(function() {
    var track = document.getElementById('pp-banners-track');
    if (!track) { return; }

    var slides = track.querySelectorAll('.pp-banner-slide');
    if (slides.length < 1) { return; }

    var current   = 0;
    var total     = slides.length;
    var autoTimer = null;
    var AUTO_INTERVAL = 5000; // ms

    var prevBtn = document.getElementById('pp-carousel-prev');
    var nextBtn = document.getElementById('pp-carousel-next');
    var dotsContainer = document.getElementById('pp-carousel-dots');

    // Create dots dynamically if there are more than 1 slide.
    var dots = [];
    if (dotsContainer && total > 1) {
        for (var i = 0; i < total; i++) {
            var dot = document.createElement('button');
            dot.className = 'pp-carousel-dot' + (i === 0 ? ' active' : '');
            dot.setAttribute('data-slide', i);
            dot.setAttribute('type', 'button');
            dot.setAttribute('aria-label', 'Slide ' + (i + 1));
            dotsContainer.appendChild(dot);
            dots.push(dot);

            dot.addEventListener('click', (function(idx) {
                return function() { goToSlide(idx); };
            })(i));
        }
    }

    function goToSlide(idx) {
        if (idx < 0) { idx = total - 1; }
        if (idx >= total) { idx = 0; }
        current = idx;
        track.style.transform = 'translateX(-' + (current * 100) + '%)';

        // Update dots.
        for (var d = 0; d < dots.length; d++) {
            dots[d].classList.toggle('active', d === current);
        }

        resetTimer();
    }

    function nextSlide() { goToSlide(current + 1); }
    function prevSlide() { goToSlide(current - 1); }

    function startTimer() {
        stopTimer();
        if (total < 2) { return; }
        autoTimer = setInterval(nextSlide, AUTO_INTERVAL);
    }

    function stopTimer() {
        if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    }

    function resetTimer() {
        if (total >= 2) { startTimer(); }
    }

    // Event listeners for prev/next buttons.
    if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
            e.preventDefault();
            prevSlide();
        });
    }
    if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
            e.preventDefault();
            nextSlide();
        });
    }

    // Pause auto-play on hover.
    var carousel = document.getElementById('pp-banners-carousel');
    if (carousel) {
        carousel.addEventListener('mouseenter', stopTimer);
        carousel.addEventListener('mouseleave', function() { if (total >= 2) { startTimer(); } });
    }

    // Start auto-play.
    startTimer();
})();
{{/js}}

